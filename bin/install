#!/bin/bash
source "$(dirname "$(realpath "$0")")"/functions
./bin/clean
try $PYTHON -m venv "venv-$PKGNAME"
try . ./venv-$PKGNAME/bin/activate
# from here we want to use python from virtualenv, not system $PYTHON
try python3 -m pip install -U pip setuptools wheel build
# following convention of having 'dev' section in
# [project.optional-dependencies] for pytest & flake8, etc..
try pip install .[dev]
# install this package as --editable / "in dev mode"
try pip install -e .
./bin/test
##try pyflakes ./$PKGNAME
ok "to activate the virtualenv, run: 'source ./venv-$PKGNAME/bin/activate'"
