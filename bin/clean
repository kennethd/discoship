#!/bin/bash
source "$(dirname "$(realpath "$0")")"/functions
try find ./$PKGNAME -name '*.pyc' -exec rm '{}' \;
try find ./$PKGNAME -path '*/__pycache__' -exec rmdir '{}' \+
# deactivate is a function not a script, if it is defined, call it & it will
# destroy VIRTUAL_ENV env var (and definition of itself)
type deactivate >/dev/null 2>&1 && deactivate
try rm -rf "venv-$PKGNAME" ./build ./dist ./$PKGNAME.egg-info ./.pytest_cache
