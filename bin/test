#!/bin/bash
source "$(dirname "$(realpath "$0")")"/functions
[[ -z "$VIRTUAL_ENV" ]] && die "you must activate virtualenv first: 'source ./venv-$PKGNAME/bin/activate'"
echo "$VIRTUAL_ENV" | grep $PKGNAME || die "you might have the wrong virtualenv activated: $VIRTUAL_ENV" 
which pytest || die pytest not found, you should reinstall. run ./bin/install
# specify tests to run:
# ./bin/test discoship/tests/test_testing.py::test_bs4_data_fixtures   # specific test
# ./bin/test discoship/tests/test_testing.py                           # tests from specific module
# ./bin/test discoship/tests/usps                                      # all tests from directory
# ./bin/test -m windows                                                # tests decorated with marker @pytest.mark.windows
# see https://docs.pytest.org/en/latest/how-to/usage.html#specifying-tests-selecting-tests
# and https://docs.pytest.org/en/9.0.x/example/markers.html
TEST_SPEC="$*"
try pytest --cov=$PKGNAME -vv --doctest-modules -p no:cacheprovider --showlocals "$TEST_SPEC"
